                    <item name="componentType" xsi:type="string">container</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/form/components/html</item>
                    <item name="content" xsi:type="string" translate="true">These values are computed automatically by Jev every time this product is saved. Enable Jev under Stores &gt; Configuration &gt; Services &gt; Jev.</item>
                    <item name="sortOrder" xsi:type="number">0</item>
                </item>
            </argument>
        </container>
        <container name="container_jev_product_health">
